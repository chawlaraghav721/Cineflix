# Copy this file to .env and set your private MongoDB Atlas URI.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Generate locally: node -e "process.stdout.write(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
